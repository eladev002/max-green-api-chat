# ---------------------------------------------------------------------------
# GREEN-API connection settings (all optional — the login form has priority).
#
# Base URL used by the browser.
#   Default (recommended): /green-api  -> proxied by Vite in dev and by
#                          server/proxy.mjs in production. Required because
#                          api.green-api.com does not return CORS headers.
#   Direct:                https://api.green-api.com  (only if your network or
#                          the API allows direct browser calls)
# ---------------------------------------------------------------------------
VITE_GREEN_API_BASE_URL=/green-api

# ---------------------------------------------------------------------------
# Only needed when the browser calls https://api.green-api.com directly and the
# provider requires an access token in a header. Normally leave empty.
# ---------------------------------------------------------------------------
VITE_GREEN_API_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Long-poll timeout in seconds for receiveNotification (0 = return immediately).
# ---------------------------------------------------------------------------
VITE_GREEN_API_RECEIVE_TIMEOUT=20

# ---------------------------------------------------------------------------
# Prefill for the login form (convenient for local demo, do NOT commit secrets).
# ---------------------------------------------------------------------------
VITE_GREEN_API_ID_INSTANCE=
VITE_GREEN_API_TOKEN_INSTANCE=

# ---------------------------------------------------------------------------
# Dev-server proxy target for the /green-api prefix (see vite.config.ts).
# Change this to https://api.max.ru if your instance points at MAX.
# ---------------------------------------------------------------------------
GREEN_API_PROXY_TARGET=https://api.green-api.com

# Port / public URL of the standalone production proxy (server/proxy.mjs).
PORT=8081
PUBLIC_DIR=dist
